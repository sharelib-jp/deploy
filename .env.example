# 公開する HTTPS ホスト名（ポート・スキームは含めない）
AUTH_DOMAIN=auth.example.com
REPOSITORY_DOMAIN=repository.example.com
MAIN_DOMAIN=library.example.com

# 各サービスの TOML を設定の元にする。相対パスは _deploy 基準。
# 手元の設定を使う場合は config.toml のパスに変更する。
AUTH_CONFIG_TEMPLATE=../auth-service/config.example.toml
REPOSITORY_CONFIG_TEMPLATE=../repository-service/api/config.example.toml
MAIN_CONFIG_TEMPLATE=../main-service/api/config.example.toml

# コンテナイメージ。ローカルビルドする場合は docker compose up -d --build
AUTH_IMAGE=ghcr.io/sharelib-jp/auth-service:latest
REPOSITORY_IMAGE=ghcr.io/sharelib-jp/repository-service:latest
MAIN_IMAGE=ghcr.io/sharelib-jp/main-service:latest
GATEWAY_IMAGE=sharelib-gateway:local

# PostgreSQL は共通の postgres:5432。DB と所有ユーザーをサービスごとに分離。
# 空の秘密値は prepare.py が生成する。初期化済みの DB のパスワードは変更しない。
POSTGRES_PASSWORD=
AUTH_POSTGRES_DB=auth
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=
REPOSITORY_POSTGRES_DB=repository
REPOSITORY_POSTGRES_USER=repository
REPOSITORY_POSTGRES_PASSWORD=

OAUTH_HMAC_SECRET=
REPOSITORY_OIDC_CLIENT_SECRET=

# Read-only catalog credential shared by repository and main.
CATALOG_API_TOKEN=

# Optional backend override for main-service; empty uses Docker service DNS
# (http://repository:8081), or http://localhost:8081 with --native.
MAIN_REPOSITORY_BASE_URL=
