# 共通の公開 HTTPS ホスト名。gateway・公開 URL・OIDC 接続で共有する。
# ポート・スキームは含めない。各サービス固有の設定は config/*.config.toml に記載。
AUTH_DOMAIN=auth.example.com
REPOSITORY_DOMAIN=repository.example.com
MAIN_DOMAIN=library.example.com

# Compose のコンテナイメージ。ローカルビルドは docker compose up -d --build
AUTH_IMAGE=ghcr.io/sharelib-jp/auth-service:latest
REPOSITORY_IMAGE=ghcr.io/sharelib-jp/repository-service:latest
MAIN_IMAGE=ghcr.io/sharelib-jp/main-service:latest
GATEWAY_IMAGE=sharelib-gateway:local

# PostgreSQL は共通の postgres:5432。DB と所有ユーザーをサービスごとに分離。
# 空の秘密値は prepare.py が生成する。初期化済みの DB のパスワードは変更しない。
POSTGRES_PASSWORD=
AUTH_POSTGRES_DB=auth
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=
REPOSITORY_POSTGRES_DB=repository
REPOSITORY_POSTGRES_USER=repository
REPOSITORY_POSTGRES_PASSWORD=

# Read-only catalog credential shared by repository and main.
# Empty is generated by prepare.py. Service-specific secrets belong in config/.
CATALOG_API_TOKEN=

# Public access uses Cloudflare Tunnel. Enable with --profile tunnel.
# Set a remotely-managed tunnel token; route each public host to http://gateway:80.
# Cloudflare handles public HTTPS. No DNS API token is needed.
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared:latest
CLOUDFLARE_TUNNEL_TOKEN=

# Optional pgAdmin 4. Enable with --profile admin.
PGADMIN_IMAGE=docker.io/dpage/pgadmin4:9.19
PGADMIN_DEFAULT_EMAIL=admin@example.com
# Empty is generated by prepare.py. This is the pgAdmin login password,
# independent of the PostgreSQL database passwords above.
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_BIND_ADDRESS=127.0.0.1
PGADMIN_PORT=5050

# To enable both optional services for ordinary `docker compose up`:
# COMPOSE_PROFILES=tunnel,admin
